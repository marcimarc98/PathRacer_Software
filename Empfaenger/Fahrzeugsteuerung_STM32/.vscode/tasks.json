{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "Debug",
        "--fresh"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "Debug"
      ],
      "dependsOn": [
        "Configure Debug"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flash STM32 (CubeProgrammer CLI)",
      "type": "process",
      "command": "STM32_Programmer_CLI.exe",
      "args": [
        "-c",
        "port=SWD",
        "-w",
        "${workspaceFolder}\\build\\Debug\\firmware.elf",
        "-rst"
      ],
      "dependsOn": [
        "Build Debug"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
