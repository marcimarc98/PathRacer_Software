{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Debug (Managed ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "servertype": "stlink",
      "interface": "swd",
      "device": "STM32F303K8Tx",
      "executable": "${workspaceFolder}/build/Debug/firmware.elf",
      "gdbPath": "C:\\Tools\\ARM_GNU_TOOLCHAIN\\bin\\arm-none-eabi-gdb.exe",
      "serverpath": "ST-LINK_gdbserver.exe",
      "stm32cubeprogrammer": "C:\\Program Files\\STMicroelectronics\\STM32Cube\\STM32CubeProgrammer\\bin",
      "svdFile": "${workspaceFolder}/.vscode/STM32F303.svd",
      "gdbInterruptMode": "sigint",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build Debug",
      "serverArgs": [
        "--pend-halt-timeout",
        "10000"
      ]
    }
  ]
}
