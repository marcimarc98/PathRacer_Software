{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "gdbtarget",
      "request": "attach",
      "name": "ESP-IDF JTAG Debug (ESP32)",
      "program": "${workspaceFolder}/build/esp32_idf_playground.elf",
      "gdb": "C:/Espressif/tools/xtensa-esp-elf-gdb/16.3_20250913/xtensa-esp-elf-gdb/bin/xtensa-esp32-elf-gdb.exe",
      "runOpenOCD": true,
      "buildFlashMonitor": false,
      "verifyAppBinBeforeDebug": false,
      "initialBreakpoint": "app_main",
      "target": {
        "connectCommands": [
          "set remotetimeout 20",
          "-target-select extended-remote localhost:3333"
        ],
        "uart": {
          "serialPort": "COM6",
          "baudRate": 115200
        }
      }
    }
  ]
}
