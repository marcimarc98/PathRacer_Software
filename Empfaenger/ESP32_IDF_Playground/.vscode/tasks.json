{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF: Set Target esp32",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". 'C:/Espressif/tools/Microsoft.v6.0.1.PowerShell_profile.ps1'; Invoke-idfpy set-target esp32"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". 'C:/Espressif/tools/Microsoft.v6.0.1.PowerShell_profile.ps1'; Invoke-idfpy build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "ESP-IDF: Flash",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". 'C:/Espressif/tools/Microsoft.v6.0.1.PowerShell_profile.ps1'; Invoke-idfpy -p COM6 flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "ESP-IDF: Build",
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: Monitor",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". 'C:/Espressif/tools/Microsoft.v6.0.1.PowerShell_profile.ps1'; Invoke-idfpy -p COM6 monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: Build Flash Monitor",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". 'C:/Espressif/tools/Microsoft.v6.0.1.PowerShell_profile.ps1'; Invoke-idfpy -p COM6 build flash monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
